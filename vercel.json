{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/nm7-private.m3u.js": {
      "includeFiles": "playlist/*.b64"
    },
    "api/nm7-private-router.m3u.js": {
      "includeFiles": "playlist/*.b64"
    }
  },
  "rewrites": [
    {
      "source": "/api/nm7-private.m3u",
      "destination": "/api/nm7-private-router.m3u"
    }
  ],
  "headers": [
    {
      "source": "/api/6ZQ5.m3u",
      "headers": [
        { "key": "Content-Type", "value": "audio/x-mpegurl; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/api/nm7-private.m3u",
      "headers": [
        { "key": "Content-Type", "value": "audio/x-mpegurl; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
