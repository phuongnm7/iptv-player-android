<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/navy">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="40dp"
            android:src="@drawable/nm7_main_logo"
            android:scaleType="centerInside"
            android:contentDescription="Logo NM7 IPTV" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NM7 IPTV"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live TV • Playlists • EPG"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReloadUrl"
            android:layout_width="88dp"
            android:layout_height="42dp"
            android:background="@drawable/button_secondary"
            android:text="↻ Làm mới"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnWallpaper"
            android:layout_width="92dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_secondary"
            android:text="⚙ Cài đặt"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAllChannels"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/button_primary"
            android:text="TV&#10;Tất cả kênh"
            android:textAllCaps="false"
            android:textColor="@color/navy"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFavorites"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/button_secondary"
            android:text="★&#10;Yêu thích"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRecent"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="5dp"
            android:background="@drawable/button_secondary"
            android:text="◷&#10;Gần đây"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSources"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/button_secondary"
            android:text="☰&#10;Nguồn"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/importPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel"
        android:padding="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thêm nguồn / danh sách phát"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/inputUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="textUri"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:hint="@string/playlist_url_hint"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:backgroundTint="@color/accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnLoadUrl"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_primary"
                    android:text="@string/load_url"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/navy" />

                <Button
                    android:id="@+id/btnOpenFile"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/button_secondary"
                    android:text="@string/open_file"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnPlayUrl"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/button_secondary"
                android:text="▶ Phát URL trực tiếp"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/inputSearch"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:hint="⌕  Tìm kênh, nhóm hoặc URL…"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:backgroundTint="@color/accent"
            android:paddingHorizontal="12dp" />

        <Button
            android:id="@+id/btnClearFilters"
            android:layout_width="74dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/button_secondary"
            android:text="Bỏ lọc"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/groupRow"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:listSelector="@drawable/list_focus"
            android:clipToPadding="false"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="20dp"
            android:text="Chưa có kênh phù hợp."
            android:textColor="@color/text_secondary"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
