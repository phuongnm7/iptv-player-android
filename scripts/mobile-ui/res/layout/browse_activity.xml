<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen: toolbar + scrollable section tabs + swappable content area.
     NOTE: activities extend FragmentActivity (not AppCompatActivity), so Material
     widgets MUST use explicit com.google.android.material.* tags. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101014"
    android:paddingBottom="64dp">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/browse_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#101014">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="64dp"
            android:paddingStart="12dp" android:paddingEnd="8dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="28dp" android:layout_height="32dp"
                android:src="@drawable/nm7_tube_logo" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginEnd="12dp"
                android:text="SmartTube" android:textColor="#FFFFFF" android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/nm7_search" android:layout_width="48dp"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/browse_ic_search" android:tint="#333333"
                android:contentDescription="Tìm kiếm" />
            <ImageButton android:id="@+id/nm7_voice" android:layout_width="40dp"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/nm7_mic" android:contentDescription="Tìm kiếm bằng giọng nói" />
            <ImageButton android:id="@+id/nm7_account" android:layout_width="48dp"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/browse_ic_account" android:tint="#FF7A00"
                android:contentDescription="@string/dialog_account_list" />
        </LinearLayout>
        <!-- Keep the original menu and refresh action accessible from the search long press. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/browse_toolbar" android:layout_width="match_parent"
            android:layout_height="0dp" android:visibility="gone" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/browse_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="scrollable"
            app:tabIndicatorHeight="0dp"
            app:tabBackground="@drawable/nm7_tab_bg"
            app:tabTextColor="#EEEEEE"
            app:tabSelectedTextColor="#101014"
            app:tabMinWidth="72dp"
            app:tabPaddingStart="14dp"
            app:tabPaddingEnd="14dp" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/browse_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TYPE_GRID / TYPE_SHORTS_GRID / TYPE_MULTI_GRID: 2-column card grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/browse_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <!-- TYPE_ROW: vertical list of titled horizontal card rows -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/browse_rows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <!-- TYPE_SETTINGS_GRID: simple icon+title rows -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/browse_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <!-- Error state: centered message + optional action button -->
        <LinearLayout
            android:id="@+id/browse_error_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/browse_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBody1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/browse_error_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/browse_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>


